<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboto_ros</name>
  <version>0.1.0</version>
  <description>
    ROS 2 layer over roboto_core: SLAM, GIS-prior planning, discrepancy
    detection and replanning, running live against Gazebo Fortress.
    All algorithms live in roboto_core and are tested without ROS; this
    package is message plumbing and visualisation.
  </description>
  <maintainer email="therbligsproject2@gmail.com">hem</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>roboto_core</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
