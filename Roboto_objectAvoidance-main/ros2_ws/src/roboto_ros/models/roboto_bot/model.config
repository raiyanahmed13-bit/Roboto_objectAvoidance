<?xml version="1.0"?>
<model>
  <name>roboto_bot</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    Differential-drive ground robot with a 2D gpu_lidar, for GIS-prior SLAM.
    Sensor and wheel parameters are mirrored from site.yaml and pinned by
    tests/test_robot_model.py.
  </description>
</model>
